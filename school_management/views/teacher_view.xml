<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View (List View) for Teachers -->
    <record id="view_teacher_tree" model="ir.ui.view">
        <field name="name">teacher.tree</field>
        <field name="model">teacher</field>
        <field name="arch" type="xml">
            <list string="Teachers">
                <field name="name"/>
                <field name="employee_id" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="show"/>
                <field name="qualification" optional="hide"/>
                <field name="academic_degree" optional="hide"/>
                <field name="classes_count" string="Classes"/>
            </list>
        </field>
    </record>

    <!-- Action for Teacher's Classes - DEFINE THIS FIRST -->
    <record id="action_teacher_classes" model="ir.actions.act_window">
        <field name="name">Teacher's Classes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">classe</field>
        <field name="view_mode">list</field>
        <field name="domain">[('teacher_ids', 'in', [active_id])]</field>
        <field name="context">{'default_teacher_ids': [(4, active_id)]}</field>
    </record>

    <!-- Simple Form View for Teachers - DEFINE AFTER THE ACTION -->
    <record id="view_teacher_form" model="ir.ui.view">
        <field name="name">teacher.form</field>
        <field name="model">teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Teacher Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="qualification"/>
                            <field name="years_of_experience"/>
                        </group>
                        <group>
                            <field name="academic_degree"/>
                            <field name="classes_count" string="Total Classes" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Assigned Classes" name="classes">
                            <div class="o_form_label">
                                <strong>Classes assigned to this teacher:</strong>
                            </div>

                            <!-- Action buttons -->
                            <div class="row mt16">
                                <div class="col-12">
                                    <button name="%(action_teacher_classes)d"
                                            string="View Assigned Classes"
                                            type="action"
                                            class="btn-primary mr8"/>

                                    <button name="action_assign_classes"
                                            string="Assign New Classes"
                                            type="object"
                                            class="btn-secondary"/>
                                </div>
                            </div>
                        </page>

                        <page string="Subjects &amp; Certifications" name="subjects_certs">
                            <group>
                                <group string="Subjects">
                                    <field name="subject_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Main Action -->
    <record id="action_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">teacher</field>
        <field name="view_mode">list,form</field>
    </record>



    <record id="view_teacher_assign_class_wizard" model="ir.ui.view">
        <field name="name">teacher.assign.class.wizard.form</field>
        <field name="model">teacher.assign.class.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Classes to Teacher">
                <sheet>
                    <group>
                        <field name="teacher_id"/>
                    </group>

                    <group string="Select Classes to Assign">
                        <field name="class_ids" widget="many2many_checkboxes" nolabel="1"/>
                    </group>
                </sheet>

                <footer>
                    <button name="action_confirm_assignment"
                            string="Assign Selected Classes"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Enhanced Class Tree View with Teacher Assignment -->
    <record id="view_classe_tree_enhanced" model="ir.ui.view">
        <field name="name">classe.tree.enhanced</field>
        <field name="model">classe</field>
        <field name="arch" type="xml">
            <list string="Classes">
                <field name="class_name"/>
                <field name="teacher_ids" widget="many2many_tags" string="Teachers"/>
                <field name="capacity"/>
                <field name="room"/>
                <field name="student_count"/>
                <button name="action_assign_teacher"
                        string="Assign Teacher"
                        type="object"
                        class="btn-link"
                        invisible="teacher_ids"/>
                <button name="action_unassign_teacher"
                        string="Manage Teachers"
                        type="object"
                        class="btn-link"
                        invisible="not teacher_ids"/>
            </list>
        </field>
    </record>
    <!-- Menu Item -->
    <menuitem id="menu_teacher"
              name="Teachers"
              action="action_teacher"
              parent="main_menu"
              sequence="10"/>
</odoo>